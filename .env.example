OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_CLOSED=true
RATE_LIMIT_ASK_PER_MINUTE=10
RATE_LIMIT_ASK_PER_DAY=40
RATE_LIMIT_ASK_GLOBAL_PER_DAY=200
RATE_LIMIT_UPLOAD_PER_MINUTE=5
RATE_LIMIT_UPLOAD_PER_DAY=15

# Required: random secret used to sign session JWTs. The app refuses to
# start with the shipped default or anything under 32 bytes. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ATLAS_AUTH_SECRET=

OPENAI_API_KEY=
# Luna for chat + the three auxiliary model calls (defaults match if these are omitted).
OPENAI_CHAT_MODEL=gpt-6-luna
RERANK_MODEL=gpt-6-luna
ANSWER_CHECK_MODEL=gpt-6-luna
RETRIEVAL_CHECK_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
REDIS_URL=redis://127.0.0.1:6379/0
# false: this machine can start without Redis. docker-compose.yml sets true.
REDIS_REQUIRED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_CLOSED=true
RATE_LIMIT_ASK_PER_MINUTE=10
RATE_LIMIT_ASK_PER_DAY=40
RATE_LIMIT_ASK_GLOBAL_PER_DAY=200
RATE_LIMIT_UPLOAD_PER_MINUTE=5
RATE_LIMIT_UPLOAD_PER_DAY=15
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_DAY=100
RATE_LIMIT_SIGNUP_PER_MINUTE=5
RATE_LIMIT_SIGNUP_PER_DAY=20
RATE_LIMIT_DEMO_PER_MINUTE=20
RATE_LIMIT_DEMO_PER_DAY=200
HYBRID_SEARCH_ENABLED=true
HYBRID_RRF_K=60

# Required: random secret used to sign session JWTs. The app refuses to
# start with the shipped default or anything under 32 bytes. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ATLAS_AUTH_SECRET=

# Docker deployment (docker-compose.yml on the server):
# Rackzar A record → 102.203.81.249, ports 80/443 open on the firewall.
# SITE_ADDRESS=your.domain.com          # Caddy + Let's Encrypt (no https:// prefix)
# APP_PUBLIC_URL=https://your.domain.com # Same host; password-reset and verification links
#
# Leave SITE_ADDRESS unset locally → plain HTTP on port 80 (CI default).

# Local Vite dev (not Docker):
# APP_PUBLIC_URL=http://localhost:5173
# PASSWORD_RESET_EXPOSE_TOKEN_IN_RESPONSE=true
# EMAIL_VERIFICATION_EXPOSE_TOKEN_IN_RESPONSE=true
# SMTP_HOST=

# Copy to /etc/atlas-ops.env on the server (chmod 600, root). Never commit real values.
#
# Resend: use the same sending key as SMTP_PASSWORD in /opt/atlas/.env when Resend is your provider.
OPS_ALERT_TO=you@example.com
OPS_ALERT_FROM="Atlas Ops <noreply@customchatandautomation.co.za>"
RESEND_API_KEY=re_xxxxxxxx

# Optional: alert when data/logs exceeds this many bytes (default 52428800 = 50 MiB).
# LOG_DISK_ALERT_BYTES=52428800
